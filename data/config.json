{
  "version": "1.0",
  "ai": {
    "provider": "llm_runner",
    "model": "kimi-k2.6:cloud",
    "llm_runner_command": "llm-runner",
    "llm_runner_provider": "ollama",
    "temperature": 0.3,
    "max_tokens": 8192,
    "languages": [
      "ko",
      "en"
    ]
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "GeekNews",
        "url": "https://news.hada.io/rss/news",
        "enabled": true,
        "category": "korean-tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "users": [
        "karpathy",
        "roifex"
      ],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "youtube": {
      "enabled": true,
      "channels": [
        {
          "name": "The Diary Of A CEO",
          "url": "https://www.youtube.com/channel/UCGq-a57w-aPwyi3pW7XLiHw",
          "enabled": true,
          "fetch_limit": 10,
          "category": "interviews"
        }
      ],
      "timeout_seconds": 30
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "ko"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
