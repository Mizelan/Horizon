{
  "version": "1.0",
  "ai": {
    "provider": "llm_runner",
    "model": "deepseek-v4-flash:cloud",
    "llm_runner_command": "llm-runner",
    "llm_runner_provider": "ollama",
    "temperature": 0.3,
    "max_tokens": 8192
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "GeekNews",
        "url": "https://news.hada.io/rss/news",
        "enabled": true,
        "category": "korean-tech-news"
      },
      {
        "name": "Lobsters",
        "url": "https://lobste.rs/rss",
        "enabled": true,
        "category": "technology"
      },
      {
        "name": "Dev.to - Top Weekly",
        "url": "https://dev.to/feed",
        "enabled": true,
        "category": "developer-community"
      },
      {
        "name": "\uc694\uc998IT",
        "url": "https://yozm.wishket.com/magazine/feed/",
        "enabled": true,
        "category": "korean-tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "programming",
          "enabled": true,
          "sort": "hot",
          "fetch_limit": 25,
          "min_score": 10
        },
        {
          "subreddit": "ArtificialInteligence",
          "enabled": true,
          "sort": "hot",
          "fetch_limit": 25,
          "min_score": 10
        },
        {
          "subreddit": "gamedev",
          "enabled": true,
          "sort": "hot",
          "fetch_limit": 25,
          "min_score": 10
        },
        {
          "subreddit": "ClaudeCode",
          "enabled": true,
          "sort": "hot",
          "fetch_limit": 25,
          "min_score": 10
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "users": [
        "karpathy",
        "elonmusk"
      ],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "youtube": {
      "enabled": true,
      "channels": [
        {
          "name": "The Diary Of A CEO",
          "url": "https://www.youtube.com/channel/UCGq-a57w-aPwyi3pW7XLiHw",
          "enabled": true,
          "fetch_limit": 10,
          "category": "interviews"
        },
        {
          "name": "Chester Roh",
          "url": "https://www.youtube.com/@chester_roh",
          "enabled": true,
          "fetch_limit": 10,
          "category": "tech"
        },
        {
          "name": "ScienceADAM",
          "url": "https://www.youtube.com/@ScienceADAM",
          "enabled": true,
          "fetch_limit": 10,
          "category": "science"
        },
        {
          "name": "All-In Podcast",
          "url": "https://www.youtube.com/@allin",
          "enabled": true,
          "fetch_limit": 10,
          "category": "tech-business"
        },
        {
          "name": "Kurzgesagt",
          "url": "https://www.youtube.com/@kurzgesagt",
          "enabled": true,
          "fetch_limit": 10,
          "category": "science"
        }
      ],
      "timeout_seconds": 30
    },
    "site": {
      "enabled": true,
      "sites": [
        {
          "name": "Anthropic Engineering Blog",
          "url": "https://www.anthropic.com/engineering",
          "type": "anthropic_blog",
          "enabled": true,
          "category": "ai"
        },
        {
          "name": "Tildes",
          "url": "https://tildes.net/",
          "type": "tildes",
          "enabled": true,
          "category": "technology"
        },
        {
          "name": "Refetch",
          "url": "https://refetch.io/",
          "type": "refetch",
          "enabled": true,
          "category": "technology"
        }
      ],
      "timeout_seconds": 30
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}